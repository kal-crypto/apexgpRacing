# Netlify _headers (backup for netlify.toml). Also works if you drag-drop this folder.
# The bare domain is "/" and not "/index.html" — cover both, or a deploy stays invisible.
/
  Cache-Control: no-store, must-revalidate
/index.html
  Cache-Control: no-store, must-revalidate
/*.js
  Cache-Control: public, max-age=31536000, immutable
